50%;transform:rotateX(65deg) rotate(-25deg)}.orb-label{position:absolute;right:-5%;bottom:12%;border:1px solid var(--line);background:rgba(13,22,42,.88);backdrop-filter:blur(12px);padding:17px 20px;border-radius:7px;font-size:11px;letter-spacing:.1em}.orb-label strong{display:block;font-size:17px;letter-spacing:0;margin-bottom:4px}@keyframes float{50%{transform:translateY(-18px)}}.strip{border-bottom:1px solid var(--line);padding:25px 0}.strip-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;color:#8191b1;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.section{padding:115px 0}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:35px;margin-bottom:45px}.section h2{font-size:clamp(42px,6vw,77px);line-height:1.04;margin:14px 0 0}.section-heading p{max-width:355px;line-height:1.8;color:var(--muted)}.project{display:grid;grid-template-columns:1.2fr .8fr;border:1px solid var(--line);background:linear-gradient(145deg,#12192a,#0b0f1b);border-radius:12px;overflow:hidden}.project-preview{min-height:420px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;background:radial-gradient(circle at 50% 30%,#353a43,#0a0a0a 70%)}.project-preview:before{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.5),transparent 65%),url('https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=1000&q=70') center/cover;filter:grayscale(1);opacity:.52;transition:transform .5s}.project:hover .project-preview:before{transform:scale(1.05)}.project-preview h3{position:relative;z-index:1;font-family:'Space Grotesk',sans-serif;font-size:clamp(46px,6vw,82px);letter-spacing:-.09em;text-align:center;line-height:.94;text-shadow:0 5px 30px #000}.project-preview h3 span{display:block;font-size:14px;letter-spacing:.42em;margin-top:18px}.project-info{padding:45px;display:flex;flex-direction:column;justify-content:center}.project-info h3{font:700 37px 'Space Grotesk',sans-serif;letter-spacing:-.05em;margin:15px 0}.project-info p{color:var(--muted);line-height:1.9}.tags{display:flex;gap:8px;flex-wrap:wrap;margin:22px 0 35px}.tags span{border:1px solid var(--line);padding:8px 11px;border-radius:30px;color:#bdc9e1;font-size:11px}.project-info .btn{align-self:flex-start}.demo-label{margin-top:14px;font-size:11px;color:#91a1c1}.services{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.service{border:1px solid var(--line);border-radius:10px;padding:32px;background:#101625;transition:transform .25s,border-color .25s}.service:hover{transform:translateY(-6px);border-color:#5377b4}.service .number{font-size:11px;color:var(--cyan);letter-spacing:.2em}.service h3{font:700 25px 'Space Grotesk',sans-serif;letter-spacing:-.04em;margin:38px 0 14px}.service p{font-size:14px;line-height:1.85;color:var(--muted);margin:0}.process{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.step{padding:26px 0;border-top:1px solid #4a6597}.step b{font:700 44px 'Space Grotesk',sans-serif;color:#5d91ff}.step h3{font:700 22px 'Space Grotesk',sans-serif;margin:20px 0 12px}.step p{color:var(--muted);font-size:14px;line-height:1.85}.contact{padding:105px 0;background:linear-gradient(120deg,#111d3b,#101522 60%,#0c111c);border-block:1px solid var(--line)}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:start}.contact h2{font-size:clamp(50px,7vw,92px)}.contact p{line-height:1.85;color:var(--muted)}.contact-form{padding:30px;background:#0b1222;border:1px solid var(--line);border-radius:10px}.contact-form label{display:block;font-size:12px;font-weight:700;margin-bottom:9px}.contact-form input,.contact-form textarea{width:100%;background:#111b30;border:1px solid #34435f;color:white;border-radius:5px;padding:14px;margin-bottom:20px;resize:vertical}.contact-form textarea{min-height:130px}.contact-form .btn{width:100%}.contact-form small{display:block;color:var(--muted);line-height:1.6;margin-top:15px}.footer{padding:35px 0}.footer-inner{display:flex;justify-content:space-between;align-items:center;gap:20px}.footer p{font-size:12px;color:var(--muted)}.reveal{opacity:0;transform:translateY(22px);transition:opacity .65s,transform .65s}.reveal.visible{opacity:1;transform:none}.progress{position:fixed;z-index:60;top:0;left:0;height:2px;background:linear-gradient(90deg,var(--blue),var(--cyan));width:0;pointer-events:none}@media(max-width:900px){.hero-grid{grid-template-columns:1fr;padding:95px 0}.visual{display:none}.project{grid-template-columns:1fr}.project-preview{min-height:340px}.services{grid-template-columns:1fr}.contact-grid{grid-template-columns:1fr;gap:35px}.section{padding:85px 0}}@media(max-width:650px){.nav{height:68px}.menu-toggle{display:block}.nav-links{display:none;position:absolute;top:68px;left:0;right:0;background:#0c1322;border-bottom:1px solid var(--line);padding:25px 5%;flex-direction:column;align-items:flex-start}.nav-links.open{display:flex}.nav-cta{display:none}.hero{min-height:620px}.hero h1{font-size:clamp(57px,13vw,84px)}.hero p{font-size:15px}.section-heading{display:block}.section-heading p{margin-top:22px}.project-info{padding:28px}.project-preview{min-height:260px}.process{grid-template-columns:1fr}.contact-form{padding:22px}.footer-inner{flex-direction:column;text-align:center}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}.reveal{opacity:1;transform:none}}
